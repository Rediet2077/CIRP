# CIRP Django Backend Environment Variables
DEBUG=True
SECRET_KEY=replace-with-your-own-secret-key
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (PostgreSQL 17 on Port 5432)
DATABASE_URL=postgres://postgres@localhost:5432/cirp_db

# CORS Configuration (React Admin Dashboard & Local Clients)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# AI Microservice URL (FastAPI running on Port 8001)
AI_SERVICE_URL=http://localhost:8001
